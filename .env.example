# Server-only Gemini credentials. Do not prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Used server-side by the quote flow service guide; no public-prefixed key is used.
# Optional alias used by the Google GenAI SDK if GEMINI_API_KEY is unset.
# GOOGLE_API_KEY=

# Database connection (libsql via @libsql/client + Drizzle ORM; Turso-hosted
# in production). Server-only.
#   Local dev:        file:./data/autocare.db  (run `npm run db:migrate` first)
#   Tests / CI:       :memory:                  (default when unset; self-initializing)
#   Production:       libsql://<db>-<org>.turso.io  (from `turso db show`)
DATABASE_URL=file:./data/autocare.db

# Auth token for remote Turso/libsql databases (`turso db tokens create <db>`).
# Leave empty for local file: and :memory: URLs — it is ignored there.
DATABASE_AUTH_TOKEN=

# Public site URL used for redirects (e.g. admin logout). No secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC secret signing admin session cookies. REQUIRED in production —
# when unset, a random per-process secret is used (sessions die on restart).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Admin login credentials in production (no built-in fallback).
# One var per account, format "salt_hex:scrypt_hash_hex":
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
# Outside production the bundled demo hashes (admin/manager/staff) apply.
# ADMIN_CREDENTIAL_ADMIN=
# ADMIN_CREDENTIAL_MANAGER=
# ADMIN_CREDENTIAL_STAFF=

# Demo data reset (POST /api/ai/reset and the reset_demo_data agent tool) is
# DISABLED in production unless explicitly enabled:
# ALLOW_DEMO_RESET=true
