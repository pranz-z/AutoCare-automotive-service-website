# Server-only Gemini credentials. Do not prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Used server-side by the quote flow service guide; no public-prefixed key is used.
# Optional alias used by the Google GenAI SDK if GEMINI_API_KEY is unset.
# GOOGLE_API_KEY=

# SQLite database file (server-only, node:sqlite + Drizzle).
# Defaults to an in-memory database; set a file path to persist data across restarts.
# Example: DATABASE_URL=file:./data/autocare.db
DATABASE_URL=file:./data/autocare.db

# Public site URL used for redirects (e.g. admin logout). No secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC secret signing admin session cookies. REQUIRED in production —
# when unset, a random per-process secret is used (sessions die on restart).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=43e49ca7e46d74bde3418412bcf4bc2e1a9df330957d2cbe7aa1e9407b2afa19
